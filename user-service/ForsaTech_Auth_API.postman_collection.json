{
  "info": {
    "_postman_id": "forsatech-auth-collection",
    "name": "ForsaTech - Authentication & Users API",
    "description": "Collection complète pour tester les endpoints d'authentification et de gestion des utilisateurs",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json"
  },
  "item": [
    {
      "name": "Authentication",
      "item": [
        {
          "name": "Sign Up - Créer un compte",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json",
                "type": "text"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"firstName\": \"Jean\",\n  \"lastName\": \"Dupont\",\n  \"email\": \"jean@example.com\",\n  \"password\": \"password123\",\n  \"confirmPassword\": \"password123\"\n}"
            },
            "url": {
              "raw": "{{base_url}}/api/auth/signup",
              "host": [
                "{{base_url}}"
              ],
              "path": [
                "api",
                "auth",
                "signup"
              ]
            },
            "description": "Créer un nouveau compte utilisateur avec email et mot de passe"
          },
          "response": []
        },
        {
          "name": "Sign In - Se connecter",
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "if (pm.response.code === 200) {",
                  "    var jsonData = pm.response.json();",
                  "    pm.environment.set(\"auth_token\", jsonData.token);",
                  "    pm.environment.set(\"user_id\", jsonData.user.id);",
                  "    console.log(\"✅ Token sauvegardé: \" + jsonData.token);",
                  "}"
                ]
              }
            }
          ],
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json",
                "type": "text"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"email\": \"jean@example.com\",\n  \"password\": \"password123\"\n}"
            },
            "url": {
              "raw": "{{base_url}}/api/auth/signin",
              "host": [
                "{{base_url}}"
              ],
              "path": [
                "api",
                "auth",
                "signin"
              ]
            },
            "description": "Se connecter avec email et mot de passe - Récupère un JWT token"
          },
          "response": []
        }
      ]
    },
    {
      "name": "Users Management",
      "item": [
        {
          "name": "Get All Users - Récupérer tous les utilisateurs",
          "request": {
            "method": "GET",
            "header": [
              {
                "key": "Authorization",
                "value": "Bearer {{auth_token}}",
                "type": "text"
              }
            ],
            "url": {
              "raw": "{{base_url}}/api/users",
              "host": [
                "{{base_url}}"
              ],
              "path": [
                "api",
                "users"
              ]
            },
            "description": "Récupérer la liste de tous les utilisateurs (nécessite l'authentification)"
          },
          "response": []
        },
        {
          "name": "Get User by ID - Récupérer un utilisateur",
          "request": {
            "method": "GET",
            "header": [
              {
                "key": "Authorization",
                "value": "Bearer {{auth_token}}",
                "type": "text"
              }
            ],
            "url": {
              "raw": "{{base_url}}/api/users/{{user_id}}",
              "host": [
                "{{base_url}}"
              ],
              "path": [
                "api",
                "users",
                "{{user_id}}"
              ]
            },
            "description": "Récupérer les détails d'un utilisateur spécifique par son ID"
          },
          "response": []
        },
        {
          "name": "Create User - Créer un utilisateur",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json",
                "type": "text"
              },
              {
                "key": "Authorization",
                "value": "Bearer {{auth_token}}",
                "type": "text"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"firstName\": \"Marie\",\n  \"lastName\": \"Martin\",\n  \"email\": \"marie@example.com\"\n}"
            },
            "url": {
              "raw": "{{base_url}}/api/users",
              "host": [
                "{{base_url}}"
              ],
              "path": [
                "api",
                "users"
              ]
            },
            "description": "Créer un nouvel utilisateur (sans mot de passe)"
          },
          "response": []
        },
        {
          "name": "Update User - Mettre à jour un utilisateur",
          "request": {
            "method": "PUT",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json",
                "type": "text"
              },
              {
                "key": "Authorization",
                "value": "Bearer {{auth_token}}",
                "type": "text"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"firstName\": \"Jean-Paul\",\n  \"lastName\": \"Dupont\"\n}"
            },
            "url": {
              "raw": "{{base_url}}/api/users/{{user_id}}",
              "host": [
                "{{base_url}}"
              ],
              "path": [
                "api",
                "users",
                "{{user_id}}"
              ]
            },
            "description": "Mettre à jour les informations d'un utilisateur"
          },
          "response": []
        },
        {
          "name": "Delete User - Supprimer un utilisateur",
          "request": {
            "method": "DELETE",
            "header": [
              {
                "key": "Authorization",
                "value": "Bearer {{auth_token}}",
                "type": "text"
              }
            ],
            "url": {
              "raw": "{{base_url}}/api/users/{{user_id}}",
              "host": [
                "{{base_url}}"
              ],
              "path": [
                "api",
                "users",
                "{{user_id}}"
              ]
            },
            "description": "Supprimer un utilisateur par son ID"
          },
          "response": []
        }
      ]
    },
    {
      "name": "Test Scenarios",
      "item": [
        {
          "name": "1️⃣ Scenario Complet - Inscription et Connexion",
          "item": [
            {
              "name": "Étape 1: Inscription",
              "request": {
                "method": "POST",
                "header": [
                  {
                    "key": "Content-Type",
                    "value": "application/json",
                    "type": "text"
                  }
                ],
                "body": {
                  "mode": "raw",
                  "raw": "{\n  \"firstName\": \"Alice\",\n  \"lastName\": \"Bernard\",\n  \"email\": \"alice@example.com\",\n  \"password\": \"SecurePass123\",\n  \"confirmPassword\": \"SecurePass123\"\n}"
                },
                "url": {
                  "raw": "{{base_url}}/api/auth/signup",
                  "host": [
                    "{{base_url}}"
                  ],
                  "path": [
                    "api",
                    "auth",
                    "signup"
                  ]
                },
                "description": "Créer un nouveau compte"
              },
              "response": []
            },
            {
              "name": "Étape 2: Connexion",
              "event": [
                {
                  "listen": "test",
                  "script": {
                    "exec": [
                      "if (pm.response.code === 200) {",
                      "    var jsonData = pm.response.json();",
                      "    pm.environment.set(\"auth_token\", jsonData.token);",
                      "    pm.environment.set(\"user_id\", jsonData.user.id);",
                      "    console.log(\"✅ Authentification réussie!\");",
                      "}"
                    ]
                  }
                }
              ],
              "request": {
                "method": "POST",
                "header": [
                  {
                    "key": "Content-Type",
                    "value": "application/json",
                    "type": "text"
                  }
                ],
                "body": {
                  "mode": "raw",
                  "raw": "{\n  \"email\": \"alice@example.com\",\n  \"password\": \"SecurePass123\"\n}"
                },
                "url": {
                  "raw": "{{base_url}}/api/auth/signin",
                  "host": [
                    "{{base_url}}"
                  ],
                  "path": [
                    "api",
                    "auth",
                    "signin"
                  ]
                },
                "description": "Se connecter et récupérer le token"
              },
              "response": []
            },
            {
              "name": "Étape 3: Consulter le Profil",
              "request": {
                "method": "GET",
                "header": [
                  {
                    "key": "Authorization",
                    "value": "Bearer {{auth_token}}",
                    "type": "text"
                  }
                ],
                "url": {
                  "raw": "{{base_url}}/api/users/{{user_id}}",
                  "host": [
                    "{{base_url}}"
                  ],
                  "path": [
                    "api",
                    "users",
                    "{{user_id}}"
                  ]
                },
                "description": "Utiliser le token pour accéder aux données du profil"
              },
              "response": []
            }
          ],
          "description": "Scénario complet: inscription → connexion → consultation du profil"
        }
      ]
    }
